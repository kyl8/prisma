// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  password      String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  // Optional for WebAuthn support
  Authenticator Authenticator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //busines fields
  enterprise String
  cnpj       String

  //relations
  notifications Notification[] @relation("RUserNotification")
  records       Record[]       @relation("RProdRecordUser")

  importer               Importer?        @relation("RUserImport")
  custbrok               customsbroker?   @relation("RUserCustom")
  catalogRequestsCreated CatalogRequest[] @relation("CatalogRequestCreatedBy")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Importer {
  id     String @id @default(cuid())
  userId String @unique
  // status String dado obtido através de pesquisas

  products        Product[]        @relation("RProductImporter")
  user            User             @relation("RUserImport", fields: [userId], references: [id])
  catalogRequests CatalogRequest[] @relation("CatalogRequestCompany")
}

model customsbroker {
  id     String @id @default(cuid())
  userId String @unique

  specialty String @default("Não informada")
  user      User   @relation("RUserCustom", fields: [userId], references: [id])
}

model Product {
  id               String  @id @default(cuid())
  importerId       String
  name             String  @unique
  code             String  @unique
  ncm              String  @unique
  completeness     String
  status           String
  identifierStatus Boolean @default(false)

  updatedAt DateTime
  createdAt DateTime @default(now())

  fields                  ProductField[]           @relation("RProductField")
  identifier              Identifier?              @relation("RProductIdentifier")
  records                 Record[]                 @relation("RProdRecord")
  importer                Importer                 @relation("RProductImporter", fields: [importerId], references: [id])
  catalogRequestProducts  CatalogRequestProduct[]
  catalogRequestResponses CatalogRequestResponse[]
}

//os fields, resp e records são utilizados para criar uma tabela personalizada para cada produto

model ProductField {
  id        String @id @default(cuid())
  productId String
  title     String
  label     String
  type      String

  product   Product         @relation("RProductField", fields: [productId], references: [id])
  responses ProdFieldResp[] @relation("RProdFieldResp")
}

model Record {
  id        String @id @default(cuid())
  productId String
  userId    String

  createdAt DateTime        @default(now())
  user      User            @relation("RProdRecordUser", fields: [userId], references: [id])
  Product   Product         @relation("RProdRecord", fields: [productId], references: [id])
  fieldResp ProdFieldResp[] @relation("RProdRespRecord")
}

model ProdFieldResp {
  id       String @id @default(cuid())
  fieldId  String
  recordId String
  response String

  productField ProductField @relation("RProdFieldResp", fields: [fieldId], references: [id])
  record       Record       @relation("RProdRespRecord", fields: [recordId], references: [id])
}

//o indentificador é uma ponte entre as APIs de indentificação e o nosso sistema

model Identifier {
  id        String @id @default(cuid())
  productId String @unique
  duimpId   String

  product Product @relation("RProductIdentifier", fields: [productId], references: [id])
}

model Notification {
  id          String @id @default(cuid())
  userId      String @unique
  action      String
  description String

  user User @relation("RUserNotification", fields: [userId], references: [id])
}

model CatalogRequest {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  companyId      String
  createdById    String
  recipientName  String
  recipientEmail String
  status         String    @default("waiting")
  kind           String    @default("fill")
  message        String?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  submittedAt    DateTime?
  completedAt    DateTime?

  company   Importer                 @relation("CatalogRequestCompany", fields: [companyId], references: [id])
  createdBy User                     @relation("CatalogRequestCreatedBy", fields: [createdById], references: [id])
  products  CatalogRequestProduct[]
  responses CatalogRequestResponse[]

  @@index([companyId, status])
  @@index([expiresAt])
}

model CatalogRequestProduct {
  id        String @id @default(cuid())
  requestId String
  productId String

  request CatalogRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([requestId, productId])
  @@index([productId])
}

model CatalogRequestResponse {
  id         String    @id @default(cuid())
  requestId  String
  productId  String
  fieldKey   String
  value      String
  status     String    @default("pending")
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  request CatalogRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([requestId, productId, fieldKey])
  @@index([productId, fieldKey])
}
