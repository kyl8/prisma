{
  "name": "prisma-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "pnpm --parallel --filter @prisma/frontend --filter @prisma/backend dev",
    "build": "pnpm --filter @prisma/frontend build && pnpm --filter @prisma/backend build",
    "typecheck": "pnpm --filter @prisma/backend exec tsc --noEmit",
    "test": "pnpm --filter @prisma/backend test && pnpm --filter @prisma/catalog-engine test",
    "db:generate": "pnpm --filter @prisma/backend db:generate",
    "db:deploy": "pnpm --filter @prisma/backend db:deploy",
    "db:seed:demo": "pnpm --filter @prisma/backend db:seed:demo-accounts",
    "engine:dev": "pnpm --filter @prisma/catalog-engine start"
  },
  "devDependencies": { "typescript": "^5.9.3" }
}
