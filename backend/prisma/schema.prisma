// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  password      String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  // Optional for WebAuthn support
  Authenticator Authenticator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //busines fields
  enterprise String
  cnpj       String

  //relations
  notifications Notification[] @relation("RUserNotification")
  records       Record[]       @relation("RProdRecordUser")

  importer               Importer?        @relation("RUserImport")
  custbrok               customsbroker?   @relation("RUserCustom")
  catalogRequestsCreated CatalogRequest[] @relation("CatalogRequestCreatedBy")
  activityEvents         ActivityEvent[]  @relation("ActivityActor")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Importer {
  id     String @id @default(cuid())
  userId String @unique
  // status String dado obtido através de pesquisas

  products        Product[]        @relation("RProductImporter")
  user            User             @relation("RUserImport", fields: [userId], references: [id])
  catalogRequests CatalogRequest[] @relation("CatalogRequestCompany")
  activityEvents  ActivityEvent[]
  brokerAccesses  CustomsBrokerCompanyAccess[]
  siscomexSnapshots SiscomexSnapshot[]
  siscomexSyncRuns  SiscomexSyncRun[]
}

model customsbroker {
  id     String @id @default(cuid())
  userId String @unique

  specialty String @default("Não informada")
  user      User   @relation("RUserCustom", fields: [userId], references: [id])
  companyAccesses CustomsBrokerCompanyAccess[]
}

model CustomsBrokerCompanyAccess {
  id              String @id @default(cuid())
  customsBrokerId String
  companyId       String
  createdAt       DateTime @default(now())

  customsBroker customsbroker @relation(fields: [customsBrokerId], references: [id], onDelete: Cascade)
  company       Importer       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([customsBrokerId, companyId])
  @@index([companyId])
}

model Product {
  id               String  @id @default(cuid())
  importerId       String
  name             String  @unique
  code             String  @unique
  ncm              String
  completeness     String
  status           String
  identifierStatus Boolean @default(false)

  updatedAt DateTime
  createdAt DateTime @default(now())

  fields                  ProductField[]           @relation("RProductField")
  identifier              Identifier?              @relation("RProductIdentifier")
  records                 Record[]                 @relation("RProdRecord")
  importer                Importer                 @relation("RProductImporter", fields: [importerId], references: [id])
  catalogRequestProducts  CatalogRequestProduct[]
  catalogRequestResponses CatalogRequestResponse[]
  activityEvents          ActivityEvent[]
  siscomexSyncRuns         SiscomexSyncRun[]
}

//os fields, resp e records são utilizados para criar uma tabela personalizada para cada produto

model ProductField {
  id        String @id @default(cuid())
  productId String
  title     String
  label     String
  type      String
  required  Boolean @default(false)

  product   Product         @relation("RProductField", fields: [productId], references: [id])
  responses ProdFieldResp[] @relation("RProdFieldResp")
}

model Record {
  id        String @id @default(cuid())
  productId String
  userId    String

  createdAt DateTime        @default(now())
  user      User            @relation("RProdRecordUser", fields: [userId], references: [id])
  Product   Product         @relation("RProdRecord", fields: [productId], references: [id])
  fieldResp ProdFieldResp[] @relation("RProdRespRecord")
}

model ProdFieldResp {
  id       String @id @default(cuid())
  fieldId  String
  recordId String
  response String

  productField ProductField @relation("RProdFieldResp", fields: [fieldId], references: [id])
  record       Record       @relation("RProdRespRecord", fields: [recordId], references: [id])
}

//o indentificador é uma ponte entre as APIs de indentificação e o nosso sistema

model Identifier {
  id        String @id @default(cuid())
  productId String @unique
  duimpId   String

  product Product @relation("RProductIdentifier", fields: [productId], references: [id])
}

model Notification {
    id          String @id @default(cuid())
    userId      String
    action      String
    description String
    entityType  String?
    entityId    String?
    readAt      DateTime?
    createdAt   DateTime @default(now())

    user User @relation("RUserNotification", fields: [userId], references: [id])

    @@index([userId, createdAt])
}

model CatalogRequest {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  companyId      String
  createdById    String
  recipientName  String
  recipientEmail String
  status         String    @default("waiting")
  kind           String    @default("fill")
  message        String?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  submittedAt    DateTime?
  completedAt    DateTime?

  company   Importer                 @relation("CatalogRequestCompany", fields: [companyId], references: [id])
  createdBy User                     @relation("CatalogRequestCreatedBy", fields: [createdById], references: [id])
  products  CatalogRequestProduct[]
  responses CatalogRequestResponse[]
  activityEvents ActivityEvent[]

  @@index([companyId, status])
  @@index([expiresAt])
}

enum ActivityVisibility {
  SHARED
  DISPATCHER_ONLY
  IMPORTER_ONLY
  SYSTEM_INTERNAL
}

enum ActivityType {
  REQUEST_CREATED
  REQUEST_STARTED
  REQUEST_SUBMITTED
  PRODUCT_UPDATED
  PRODUCT_SUBMITTED
  PRODUCT_APPROVED
  CORRECTION_REQUESTED
  CORRECTION_RESOLVED
  REMINDER_SENT
  CATALOG_IMPORTED
  CATALOG_INCONSISTENCY_FOUND
}

model ActivityEvent {
  id          String             @id @default(cuid())
  companyId   String
  actorUserId String?
  type        ActivityType
  visibility  ActivityVisibility
  entityType  String?
  entityId    String?
  productId   String?
  requestId   String?
  metadata    Json?
  createdAt   DateTime           @default(now())

  company Importer        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   User?           @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  request CatalogRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([actorUserId])
  @@index([productId])
  @@index([requestId])
}

model CatalogRequestProduct {
  id        String @id @default(cuid())
  requestId String
  productId String

  request CatalogRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([requestId, productId])
  @@index([productId])
}

model CatalogRequestResponse {
  id         String    @id @default(cuid())
  requestId  String
  productId  String
  fieldKey   String
  value      String
  status     String    @default("pending")
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  request CatalogRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([requestId, productId, fieldKey])
  @@index([productId, fieldKey])
}

// Official read-only evidence is kept separate from the editable product catalog.
model SiscomexSnapshot {
  id           String   @id @default(cuid())
  companyId    String
  environment  String
  subsystem    String
  resourceType String
  resourceKey  String
  payload      Json
  payloadHash  String
  fetchedAt    DateTime @default(now())

  company Importer @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, environment, resourceType, resourceKey, fetchedAt], map: "SiscomexSnapshot_scope_resource_date_idx")
}

model SiscomexSyncRun {
  id            String   @id @default(cuid())
  companyId     String
  productId     String?
  actorUserId   String
  environment   String
  status        String
  errorCode     String?
  result        Json?
  startedAt     DateTime @default(now())
  finishedAt    DateTime @default(now())

  company Importer @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([companyId, environment, finishedAt])
  @@index([productId, environment, finishedAt])
}
